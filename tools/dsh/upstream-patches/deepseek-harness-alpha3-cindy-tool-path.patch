 describe('environment and spill-file hardening', () => {
+  it('uses the Main-approved Cindy tool PATH without forwarding its activation variable', () => {
+    const previousPath = process.env.PATH
+    const previousToolPath = process.env.CINDY_DSH_TOOL_PATH
+    const previousProviderKey = process.env.CINDY_DSH_PROVIDER_API_KEY
+    const previousLeaseToken = process.env.CINDY_DSH_INTERNAL_LEASE_TOKEN
+    process.env.PATH = '/ambient-path-must-not-reach-tools'
+    process.env.CINDY_DSH_TOOL_PATH = '/usr/bin:/bin:/opt/homebrew/bin'
+    process.env.CINDY_DSH_PROVIDER_API_KEY = 'test-only-provider-secret'
+    process.env.CINDY_DSH_INTERNAL_LEASE_TOKEN = 'test-only-internal-token'
+    try {
+      const env = childEnv()
+      expect(env.PATH).toBe('/usr/bin:/bin:/opt/homebrew/bin')
+      expect(env).not.toHaveProperty('CINDY_DSH_TOOL_PATH')
+      expect(env).not.toHaveProperty('CINDY_DSH_PROVIDER_API_KEY')
+      expect(env).not.toHaveProperty('CINDY_DSH_INTERNAL_LEASE_TOKEN')
+    } finally {
+      if (previousPath === undefined) delete process.env.PATH
+      else process.env.PATH = previousPath
+      if (previousToolPath === undefined) delete process.env.CINDY_DSH_TOOL_PATH
+      else process.env.CINDY_DSH_TOOL_PATH = previousToolPath
+      if (previousProviderKey === undefined) delete process.env.CINDY_DSH_PROVIDER_API_KEY
+      else process.env.CINDY_DSH_PROVIDER_API_KEY = previousProviderKey
+      if (previousLeaseToken === undefined) delete process.env.CINDY_DSH_INTERNAL_LEASE_TOKEN
+      else process.env.CINDY_DSH_INTERNAL_LEASE_TOKEN = previousLeaseToken
+    }
+  })
+
