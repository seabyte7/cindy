+  /** Recursively enumerate regular staging files while rejecting links/special files. */
+  private async listRegularFiles(directory: string): Promise<string[]> {
+    const result: string[] = []
+    const visit = async (current: string): Promise<void> => {
+      for (const entry of (await readdir(current, { withFileTypes: true })).sort((left, right) => left.name.localeCompare(right.name))) {
+        const candidate = join(current, entry.name)
+        const metadata = await lstat(candidate)
+        if (metadata.isSymbolicLink()) {
+          throw new Error(`build-exe-for-python-sdk: sealed pkg cache source contains a symlink: ${candidate}`)
+        }
+        if (metadata.isDirectory()) {
+          await visit(candidate)
+        } else if (metadata.isFile()) {
+          result.push(candidate)
+        } else {
+          throw new Error(`build-exe-for-python-sdk: sealed pkg cache source contains a non-regular file: ${candidate}`)
+        }
+      }
+    }
+    await visit(directory)
+    return result
+  }
